# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ 環境檔說明                                                                ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# 兩份環境檔（皆 gitignored），用途不可互換：
#   .env.local  → 本機直跑（./mvnw -Dspring-boot.run.profiles=local、uv run --env-file ../.env.local）
#                 值為 host 視角：localhost:8000 / localhost:3010
#   .env        → docker compose（自動載入，指令不需帶 --env-file）
#                 值為容器內視角：deepagent-service:8000 / lf-web:3000
# 首次設定：cp .env.example .env.local 後填值（docker 版另外維護一份 .env）。
#
# 本檔分四區：
#   [0] 共用       —— 兩條線都要看
#   [A] llm api 線 —— ERD_AGENT_PROVIDER=openai-compatible（預設）
#   [B] deep agent 線 —— ERD_AGENT_PROVIDER=langgraph-analysis
#   [C] 開發工具   —— Langfuse / CloudBeaver / Dozzle
# A 與 B 二選一：選定哪條線，就只需要填該區 + [0] + （選用）[C]。


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ [0] 共用設定（兩條線都適用）                                              ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# BACKEND_PORT=8080   # 8080 被佔用時覆寫（例如 IntelliJ）

# 上傳檔解密（公司環境）：true 時每個上傳檔在落地前會先過 UploadDecryptor。
# ⚠️ 設為 true 前 MUST 先提供公司環境的 UploadDecryptor 實作 bean，否則啟動時找不到 bean 會失敗。
# ERD_UPLOAD_DECRYPTION_ENABLED=false

# ── 檔案儲存與保留清理排程 ────────────────────────────────────────────────────
# 檔案儲存為 RWX PVC 單一路線（S3/MinIO 已移除，見 docs/architecture.md「儲存後端決策」）。
# ERD_STORAGE_LOCAL_DIR=/data/files
# ERD_STORAGE_WORKSPACE_DIR=/data/workspace
#
# 上傳原始檔與 workspace 依 session 最後活動時間；artifact 依自身建立時間。
# ⚠️ 首次上線 MUST 先設 ERD_STORAGE_CLEANUP_DRY_RUN=true 跑滿一輪排程、確認刪除清單符合
# 預期後才關閉——artifact 是整份設計裡唯一標記為「不可重建」的資料，dry-run 是部署程序的
# 一部分，不是可選建議。
#
# ⚠️ WORKSPACE MUST ≥ UPLOADS。workspace 先被清掉而上傳檔還在時，「檔案已過期」的 guard
# 不會觸發，使用者追問會從空白 workspace 開工，上一輪的 dashboard 與結果檔全部消失。
# 違反此序時後端啟動會記 WARN（仍可啟動）。
# ERD_STORAGE_CLEANUP_CRON=0 0 3 * * *   # "-" 停用排程
# ERD_STORAGE_CLEANUP_DRY_RUN=true      # true：只記錄將刪除什麼，不實際刪除
# ERD_STORAGE_RETENTION_UPLOADS=180d
# ERD_STORAGE_RETENTION_WORKSPACE=180d   # MUST ≥ ERD_STORAGE_RETENTION_UPLOADS
# ERD_STORAGE_RETENTION_ARTIFACT=730d


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ [A] llm api 線（ERD_AGENT_PROVIDER=openai-compatible，未設時的預設）      ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# Java 後端（OpenAICompatibleProvider）直接呼叫 LLM 寫 HTML，不需要 deepagent-service。
# A-1 與 A-2 依認證方式二選一。
#
# 共同注意：ERD_AGENT_OPENAI_COMPATIBLE_BASE_URL 填根路徑，**不含** /v1
#          （後端會自行接上 CHAT_PATH）——與 [B] 區 Python 端的 OPENAI_BASE_URL 格式相反。

# ── A-1：OpenRouter 或任何 OpenAI-compatible 端點（bearer auth）──────────────
# ERD_AGENT_PROVIDER=openai-compatible
# ERD_AGENT_OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api
# ERD_AGENT_OPENAI_COMPATIBLE_MODEL=qwen/qwen3.6-35b-a3b
# ERD_AGENT_OPENAI_COMPATIBLE_API_KEY=sk-or-your-key-here  # 從 openrouter.ai 取得
# ERD_AGENT_OPENAI_COMPATIBLE_CHAT_PATH=/v1/chat/completions  # 預設值；僅在端點路徑不同時覆寫
# ERD_AGENT_OPENAI_COMPATIBLE_AUTH_MODE=bearer                # 預設值，可省略

# ── A-2：公司環境（token-exchange auth）──────────────────────────────────────
# 公司 LLM API 使用 j1→j2 token-exchange 認證（非標準 Bearer）：
#   1. service account 持有 j1 token（ERD_AGENT_OPENAI_COMPATIBLE_SERVICE_ACCOUNT_KEY）
#   2. POST exchange API → 取得 j2 token
#   3. j2 放入認證 header（header 名由下方 TOKEN_HEADER 指定）呼叫 LLM
# ERD_AGENT_PROVIDER=openai-compatible
# ERD_AGENT_OPENAI_COMPATIBLE_AUTH_MODE=token-exchange
# ERD_AGENT_OPENAI_COMPATIBLE_BASE_URL=https://llm.example.corp
# ERD_AGENT_OPENAI_COMPATIBLE_MODEL=qwen3.6-35b
# ERD_AGENT_OPENAI_COMPATIBLE_TOKEN_EXCHANGE_URL=https://auth.example.corp/token-exchange
# ERD_AGENT_OPENAI_COMPATIBLE_SERVICE_ACCOUNT_KEY=j1-your-service-account-key-here
# ERD_AGENT_OPENAI_COMPATIBLE_TOKEN_HEADER=<公司認證 header 名>   # token-exchange 模式必填
# ERD_AGENT_OPENAI_COMPATIBLE_TOKEN_TTL=300                             # 秒；預設值


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ [B] deep agent 線（ERD_AGENT_PROVIDER=langgraph-analysis）                ║
# ╚══════════════════════════════════════════════════════════════════════════╝
# 走獨立的 Python FastAPI + deepagents + DuckDB 服務（deepagent-service）：模型用 SQL
# 查資料再直寫 HTML。跑 [A] 線的使用者完全不需要這一區，也不需要啟動該服務
# （docker 需加 -f docker-compose.app.yml --profile deepagent 才會建置/啟動）。
# ERD_AGENT_PROVIDER=langgraph-analysis

# ── B-1：deepagent-service 自己呼叫 LLM（Python 端）──────────────────────────
# ⚠️ OPENAI_BASE_URL 必須「包含」/v1 後綴（Python openai SDK 慣例），與 [A] 區 Java 端的
# ERD_AGENT_OPENAI_COMPATIBLE_BASE_URL（**不能**含 /v1）相反。兩者常指向同一個 LLM 端點，
# 但值的格式不可互換。
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-your-key-here
# 變數名與 deepagent-service 程式內讀取的名稱一致，compose 直接原名傳入——這樣本機直跑
# （uv run --env-file ../.env.local fastapi dev）與容器吃到的是同一組值，不需要兩套命名。
# AGENT_MODEL=qwen3.6-35b

# ── B-2：Java 後端怎麼連到 deepagent-service（LangGraphAnalysisProvider）────
# ERD_AGENT_ANALYSIS_BASE_URL：deepagent-service 位址。
#   docker 內＝http://deepagent-service:8000（服務名）；本機直跑＝http://localhost:8000
# ERD_AGENT_ANALYSIS_SOURCE_ROOT：deepagent-service 視角的上傳檔根目錄（storageKey 接在其後
#   組成完整路徑；因為 backend 與 deepagent-service 共掛同一個 volume）。
# ERD_AGENT_ANALYSIS_REQUEST_TIMEOUT_SECONDS：SSE「事件間」閒置逾時秒數（預設 180）。計時器每
#   收到一個事件就重置，所以持續吐 TOKEN 的 turn 不受總時長限制；反之長時間靜默（SQL 執行與
#   LLM 思考期間不送事件）會被切斷並轉為 ANALYSIS_TIMEOUT 錯誤。
# ERD_AGENT_ANALYSIS_BASE_URL=http://deepagent-service:8000
# ERD_AGENT_ANALYSIS_SOURCE_ROOT=/data/files
# ERD_AGENT_ANALYSIS_REQUEST_TIMEOUT_SECONDS=180

# ── B-3：deepagent-service 調校常數（全部選用，值為程式內的預設）─────────────
# 這些都由 Python 端直接讀取，名稱即程式內的變數名。平常不需要動；下面標的值就是不設時
# 的行為，列出來是為了「知道有這些旋鈕、以及動它們會影響什麼」。

# 單輪允許的 graph 步數上限（工具呼叫 + 模型回合）。撞到上限會中止並回
# 「分析步驟過多而中止」。調高會讓失控的一輪燒更久才停。
# AGENT_RECURSION_LIMIT=80

# 單次模型呼叫的 output 上限（reasoning + 正文 + tool args 共用這個預算）。
# ⚠️ dashboard.html 是「單次 write_file 整份寫出」，整份 HTML 走在 tool args 裡——實測真實
# dashboard 約 18K tokens，已佔可用預算（32768 − reasoning 8192 ≈ 24.5K）的七成。調低到
# 塞不下整份時，輸出會在中途被腰斬，且 tool args 的 JSON 會被補成合法 dict 而不報錯，
# 只能靠 guard 的「缺 </html>」檢查攔下來。0 = 交給 provider 預設。
# AGENT_MAX_TOKENS=32768

# reasoning 的獨立預算（OpenRouter 的 reasoning.max_tokens）。把思考封頂，避免整個 output
# 預算燒在思考裡而正文歸零。0 = 不送 reasoning 參數，交給 provider 預設。
# AGENT_REASONING_MAX_TOKENS=8192

# OpenRouter 供應商路由。SORT 常用 throughput（挑最快）；IGNORE 是逗號分隔的黑名單。
# 兩者都不設 = 交給 OpenRouter 預設路由。非 OpenRouter 端點請留空。
# AGENT_PROVIDER_SORT=throughput
# AGENT_PROVIDER_IGNORE=

# /repair 端點單次模型呼叫的逾時秒數。該端點沒有 agent 迴圈的逐事件 heartbeat，這是唯一的
# 逾時防線；逾時視同模型呼叫失敗（回 502）。最壞情況是這個值 × 2（首次 + 一次 guard 重試）,
# 需留在 Java 端 ERD_AGENT_ANALYSIS_REQUEST_TIMEOUT_SECONDS 之內。
# REPAIR_MODEL_CALL_TIMEOUT_SECONDS=60

# dashboard guard 要不要「擋下」出貨。guard 一律執行（含 echarts 的 erd 主題套用），此開關
# 只決定：檢查沒過時要不要跑修復迴圈、以及要不要退回不顯示。
# 設 false 時 guard 照跑照記 log，但不進修復迴圈、dashboard 照發——開發／實驗時省掉最多
# 5 輪的整份重寫（那才是分鐘級的成本；guard 本身只有幾十毫秒）。
# ⚠️ 只影響 /chat，不影響 /repair。只有 false/False/FALSE 會關閉，其餘值（含 "0"、"no"）
# 一律維持阻擋——預設偏向安全那邊。
# ERD_GUARD_BLOCKING=true

# workspace 根目錄（每個 user 一個子目錄）。docker 內固定 /data/workspace（掛 named volume）；
# 本機直跑要指到一個可寫路徑，否則會嘗試寫 /data 而失敗。
# AGENT_WORKSPACE_ROOT=/data/workspace

# 內建 skills 目錄的覆寫；不設時用 deepagent-service/skills/。一般只有測試會用。
# AGENT_BUILTIN_SKILLS_DIR=

# ── B-4：deepagent-service 的公司環境認證（token-exchange）───────────────────
# ⚠️ 這一組是 **Python 端**的，與 [A-2] 區 Java 端那組是**兩套獨立設定**：Java 用
# ERD_AGENT_OPENAI_COMPATIBLE_* 前綴，Python 用裸的 AGENT_*。跑 deep agent 線時
# deepagent-service 自己直接呼叫 LLM，所以公司環境**這一組也必須填**——只填 A-2 那組
# 不會生效。這與 OPENAI_BASE_URL 要含 /v1、Java 端不含 是同一類容易搞混的不對稱。
#
# 流程（鏡像 Java TokenExchangeClient）：service account 持有 j1 →
# POST 交換端點 `{"key": j1}` → 回 `{"token": j2}` → j2 以 **raw token（無 Bearer 前綴）**
# 放進自訂 header 呼叫 LLM。此模式下 Authorization header 會被主動移除，
# 上面 B-1 的 OPENAI_API_KEY 形同無效。
#
# token 依 TTL 快取且跨請求共用（process 級 http client）；收到 401 會作廢快取、
# 換新 token 原地重試一次。

# 預設 bearer；只有填 token-exchange 才會啟用下面這組。
# AGENT_AUTH_MODE=token-exchange

# 以下三項在 token-exchange 模式下為**必填**，缺任一項服務啟動建立 model 時就會拋
# ValueError（錯誤訊息會指名缺哪個變數），不會拖到第一次呼叫 LLM 才失敗。
# AGENT_TOKEN_EXCHANGE_URL=https://auth.example.corp/token-exchange
# AGENT_TOKEN_HEADER=<公司認證 header 名>

# j1 service account key：KEY 與 KEY_FILE 至少要有一個。
# ⚠️ 兩者都設時 **FILE 優先**，而且 FILE 每次交換都會重讀——k8s secret 輪替後不必重啟。
# 生產環境建議一律用 FILE（掛 secret volume），KEY 只適合本機臨時測試。
# AGENT_SERVICE_ACCOUNT_KEY=j1-your-service-account-key-here
# AGENT_SERVICE_ACCOUNT_KEY_FILE=/var/run/secrets/llm/service-account-key

# j2 的快取秒數。設得比實際 token 壽命長會讓每次呼叫都先吃一個 401 再重試（能自癒但多一趟）。
# AGENT_TOKEN_TTL=300


# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ [C] 開發工具（選用）                                                      ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Langfuse tracing ─────────────────────────────────────────────────────────
# ⚠️ 只有 deep agent 線（[B]）會送 trace，Java 後端不送——跑 [A] 線時 Langfuse 會是空的。
# 三個變數都不設即完全停用（no-op，不建 CallbackHandler）。
# 公司環境的 LANGFUSE_HOST MUST 為公司內部位址，NEVER 指向 Langfuse 雲端 SaaS。
# 自架見 README「Langfuse 觀測」一節
# （docker compose -f docker-compose.infra.yml --profile observability up -d）。
# Key 為該 profile headless bootstrap 寫死的 dev 值（docker-compose.infra.yml 的 LANGFUSE_INIT_*）。
#
# 模式一（寫進 .env）：deepagent-service 也跑在 docker 內（走內部 DNS）
# LANGFUSE_HOST=http://lf-web:3000
# 模式二（寫進 .env.local）：deepagent-service 在本機直跑，HOST 走 host 對外埠
# LANGFUSE_HOST=http://localhost:3010
#
# LANGFUSE_PUBLIC_KEY=pk-lf-erd-cowork-dev
# LANGFUSE_SECRET_KEY=sk-lf-erd-cowork-dev

# ── CloudBeaver（Oracle 視覺化）──────────────────────────────────────────────
# 僅 docker 用（infra stack）。CLOUDBEAVER_PASSWORD 為**必填**——compose 以 `:?` 強制，
# 未設時 infra stack 會直接啟動失敗。
# CLOUDBEAVER_ADMIN=admin          # 管理帳號名稱，預設 admin
CLOUDBEAVER_PASSWORD=change-me-strong-password

# ── Dozzle（container log 檢視）──────────────────────────────────────────────
# 僅 docker 用（infra stack）。dozzle 走 simple auth，實際讀 dozzle-data/users.yml 的 hash；
# 下面這行**不會被任何程式讀取**，純粹是明文密碼備查用的註解。
# DOZZLE_PASSWORD=change-me-strong-password

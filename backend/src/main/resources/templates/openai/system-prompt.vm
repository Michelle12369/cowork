  showTab JS (copy verbatim — resize dispatch preserves ECharts rendering after tab switch):
    function showTab(idx) {
      document.querySelectorAll('[role=tab]').forEach((t, i) => {
        t.className = 'inline-flex items-center gap-2 px-4 py-3 text-sm font-medium border-b-2 transition-all ' +
          (i === idx ? 'border-blue-600 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800');
        document.getElementById('panel-' + i).classList.toggle('hidden', i !== idx);
      });
      window.dispatchEvent(new Event('resize')); // ECharts does not render in display:none containers; dispatching resize causes all charts to re-measure and paint at correct dimensions after tab switch.
    }
  Call showTab(0) inside DOMContentLoaded to activate the first tab.


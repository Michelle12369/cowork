# dev/demo-only image：合成品質資料 MCP server（見 demo_mcp_server/server.py）。
# `mcp` SDK 在主 pyproject.toml 只是 dev 依賴（正常只供測試起 fixture server）——不進
# deepagent-service/Dockerfile 的乾淨 runtime image，改用這支獨立 Dockerfile 另外裝
# `mcp`，只複製 demo server 實際會 import 的兩個模組（connectors 的 model／registry），
# 不帶 langchain/deepagents/fastapi[standard] 等主 app 的重依賴。
FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /app
RUN uv pip install --system "mcp[cli]>=1.2,<2" "uvicorn[standard]>=0.31"
COPY app/__init__.py app/__init__.py
COPY app/agent/__init__.py app/agent/__init__.py
COPY app/agent/connectors/__init__.py app/agent/connectors/__init__.py
COPY app/agent/connectors/model.py app/agent/connectors/model.py
COPY app/agent/connectors/registry.py app/agent/connectors/registry.py
COPY demo_mcp_server ./demo_mcp_server
EXPOSE 8200
CMD ["uvicorn", "demo_mcp_server.server:app", "--host", "0.0.0.0", "--port", "8200"]
